# Public URL of the app (used for QR codes, emails and Open Graph images)
APP_URL=http://localhost:3000

# Turso / libSQL. Use file:local.db for local development.
DATABASE_URL=file:local.db
DATABASE_AUTH_TOKEN=

# better-auth — generate with `openssl rand -base64 32`
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000

# Resend (magic links + email verification). Leave empty to log emails to the console.
RESEND_API_KEY=
EMAIL_FROM="tcgRank <league@tcgrank.app>"

# UploadThing (avatars + deck covers)
UPLOADTHING_TOKEN=

# Poké Cards catalog (github.com/Kaappoo/pokemon-new) — card art for deck lists,
# looked up when a deck is saved. Leave empty to save decks without art.
CARD_CATALOG_URL=
